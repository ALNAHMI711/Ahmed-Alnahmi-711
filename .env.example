# Generate with: openssl rand -hex 32
APP_SECRET_KEY=change-me-before-production
DATABASE_URL=sqlite:///./trading.sqlite3
APP_ENV=development
ADMIN_USERNAME=admin
# Set only during first run; never commit a real password.
FIRST_RUN_PASSWORD=
TRUSTED_OUTBOUND_IPS=
PUBLIC_EGRESS_IP=
CORS_ORIGINS=https://your-domain.example
SESSION_TIMEOUT_MINUTES=30
# GitHub Pages on a different site needs `none` with APP_ENV=production and HTTPS.
SESSION_COOKIE_SAMESITE=strict

POSTGRES_PASSWORD=change-me-before-production
DOMAIN=your-domain.example
API_ENCRYPTION_KEY=replace-with-output-of-python-c-cryptography.fernet.Fernet.generate_key

# Used once to bootstrap the first admin user; remove after setup.
FIRST_RUN_PASSWORD=
