# Public URL of the separately deployed FastAPI API. Do not put secrets here.
VITE_API_BASE_URL=https://api.example.com
VITE_WS_BASE_URL=wss://api.example.com
## Required for GitHub Pages. This is a public HTTPS API origin, never a secret.
VITE_API_BASE_URL=https://api.example.com
## Optional; defaults to VITE_API_BASE_URL when omitted.
VITE_WS_BASE_URL=wss://api.example.com
